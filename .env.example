# ─── Core ──────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://askyourdocs:askyourdocs@localhost:5432/askyourdocs

# ─── LLM provider ──────────────────────────────────────────────────────────
# One of: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Embeddings can come from a different provider than chat.
# One of: openai | ollama
EMBEDDING_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fully local, no API key required. Run: ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector dimensions MUST match your embedding model, and changing it
# requires re-indexing every document.
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
#   nomic-embed-text       -> 768
EMBEDDING_DIMENSIONS=1536

# ─── Storage ───────────────────────────────────────────────────────────────
# One of: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# Only when STORAGE_DRIVER=s3 (works with MinIO, R2, or real S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=askyourdocs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Ingestion ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# URL ingestion fetches server-side. These guard against SSRF; only
# disable the private-network block on a trusted, isolated network.
URL_FETCH_TIMEOUT_MS=15000
URL_FETCH_MAX_BYTES=10485760
ALLOW_PRIVATE_NETWORK_FETCH=false

# ─── Retrieval ─────────────────────────────────────────────────────────────
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8
# Answers below this cosine similarity are treated as "not in your documents".
RETRIEVAL_MIN_SCORE=0.25
# LLM-based reranking of candidates. Costs one extra call per question.
RERANK_ENABLED=true

# ─── Registration ──────────────────────────────────────────────────────────
# When false, only an admin can create accounts. The first account created
# is always an admin.
ALLOW_PUBLIC_REGISTRATION=true
